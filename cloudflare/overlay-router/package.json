{
  "name": "@ltth/overlay-router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:raw-path-ruleset": "node scripts/validate-raw-path-ruleset.mjs",
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
