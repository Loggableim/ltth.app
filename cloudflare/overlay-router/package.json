    "d1:migrate:local": "wrangler d1 migrations apply OVERLAY_ROUTING_DB --local"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
