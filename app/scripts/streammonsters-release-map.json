      "sha256": "03d3598ac50aac1553d24e234ceb9ec3a6c866d34dc89edb328309550cc9f283",
      "packageBuilder": "app/scripts/build-streammonsters-release-v18.js",
      "readmeOverlay": {
        "title": "Stream Monsters 1.7 – Competitive Arcade",
        "summary": "Stream Monsters 1.7 builds on the optional recurring free egg offer: claim it with `!adopt` during the 60-second reservation before hatching it through normal incubation, or leave it for public FIFO adoption. The portrait-first arcade introduces sealed A/B/C battle choices and balanced Striker, Guardian, Trickster, and Sustain roles.",
        "highlights": [
          "A/B/C choices stay sealed until both fighters have locked or timed out, then reveal together.",
          "Striker, Guardian, Trickster, and Sustain create readable strengths and counterplay across the six elements.",
          "Portrait arcade presentation, deterministic replays, gift eggs, and public free-egg adoption remain compatible."
        ]
      }
    },
