      "packageBuilder": "app/scripts/build-streammonsters-release-v18.js",
      "readmeOverlay": {
        "title": "Stream Monsters 1.6 – Retention Core",
        "summary": "Stream Monsters 1.6 adds an optional recurring free egg offer alongside creator-selected gift eggs. During the 60-second private reservation, the viewer must claim the egg with `!adopt` before hatching it through normal incubation. If unclaimed, the egg enters the public FIFO and another viewer can claim it with `!adopt`.",
        "highlights": [
          "A viewer's first chat creates one reserved standard free-egg offer with the release's daily eligibility default.",
          "Unclaimed free eggs become publicly adoptable after the 60-second reservation without replacing gift mappings.",
          "Gift eggs, incubation queues, hatching, collections, and permanent progress remain compatible."
        ]
      }
    },
    "1.7.0": {
      "manifestId": "streamalchemy",
      "sourcePath": "app/plugins/streamalchemy",
      "sourceCommit": "66b28c67972ada5774935eab447194700c06dc09",
      "manifestVersion": "1.7.0",
