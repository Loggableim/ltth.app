    "fadeInDuration": 300,
    "fadeOutDuration": 300,
    "blinkInterval": 3000,
    "rolePermission": "all",
    "minTeamLevel": 0,
    "requireSubscriber": false,
    "requireCustomVoice": false,
    "spriteMode": "asset-library"
