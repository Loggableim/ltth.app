{
  "id": "talking-heads",
  "name": "Talking Heads",
  "version": "1.1.0",
  "description": "Local modular 2D characters with synchronized TTS mouth animation",
  "author": "Pup Cid",
  "entry": "main.js",
  "enabled": false,
  "type": "module",
  "devStatus": "early-version",
  "dependencies": [],
  "permissions": [
    "socket.io",
    "routes",
    "tiktok-events",
    "database",
    "file-system"
  ],
  "features": [
    "Bundled Boba Animals Library",
    "Bundled Kenney Monster Builder",
    "Bundled Vector Character Builder",
    "Modular Head, Hair, Eye and Mouth Selection",
    "5-Frame Sprite Animation System",
    "Gift Avatar Lottery with Keep/Reroll",
    "TTS Audio Synchronization",
    "OBS WebSocket Integration",
    "Role-based Activation",
    "Manual Sprite Sets"
