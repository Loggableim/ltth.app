{
  "id": "talking-heads",
  "name": "Talking Heads",
  "version": "2.0.0",
  "description": "Boba Animals speaker-stage avatars with renderer-synchronized TTS animation",
  "author": "Pup Cid",
  "entry": "main.js",
  "enabled": false,
  "type": "module",
  "devStatus": "stable",
  "dependencies": [],
  "permissions": [
    "socket.io",
    "routes",
    "tiktok-events",
    "database",
    "file-system"
  ],
  "features": [
    "Bundled Boba Animals Library",
    "5-Frame Sprite Animation System",
    "First Voice Assignment Avatar Slot",
    "Cosmetic Gift Avatar Rerolls",
    "Renderer-Synchronized TTS Animation",
    "Broadcast Arcade Stream Director",
    "Public TikTok Studio Speaker Overlay",
    "OBS WebSocket Integration",
    "Role-based Activation",
    "Manual Sprite Sets"
  ],
  "config": {
    "enabled": false,
    "assetPack": "boba",
    "assetCharacter": "Fox",
    "assetOptions": {},
    "firstAssignmentEnabled": true,
    "rerollGiftEnabled": true,
    "rerollGiftId": "",
    "rerollGiftNames": ["Go Popular", "Heart Me", "Team Heart", "Team Herz"],
    "spinDurationMs": 2600,
    "cacheEnabled": true,
    "cacheDuration": 2592000,
    "obsEnabled": true,
    "obsHudEnabled": true,
    "spawnAnimationMode": "standard",
    "spawnAnimationUrl": "",
    "spawnAnimationVolume": 0.8,
    "animationDuration": 5000,
    "fadeInDuration": 300,
    "fadeOutDuration": 300,
    "blinkInterval": 3000,
    "rolePermission": "all",
    "minTeamLevel": 0,
    "requireSubscriber": false,
    "requireCustomVoice": false,
    "spriteMode": "asset-library",
    "nameplatePosition": "below",
    "nameplateFontFamily": "Inter, ui-sans-serif, system-ui, sans-serif",
    "nameplateFontSize": 14,
    "nameplateFontColor": "#ffffff",
    "nameplateBackgroundColor": "#060c1c",
    "nameplateBackgroundOpacity": 0.75,
    "nameplateTextShadow": "subtle",
    "nameplateTextStroke": "none",
    "headEntranceAnimation": "slide-up",
    "headExitAnimation": "fade",
    "nameplateEntranceAnimation": "fade",
    "nameplateExitAnimation": "fade"
  },
  "descriptions": {
    "en": "Speaker-stage avatars with Boba animal assignment slot plus mouth animation synchronized to the actual TTS renderer. Uses bundled assets without external avatar APIs.",
    "de": "Sprecheravatare mit Boba-Tier-Slot sowie Mundanimation, die mit dem echten TTS-Renderer synchronisiert ist. Nutzt gebuendelte Assets ohne externe Avatar-APIs."
  }
}
